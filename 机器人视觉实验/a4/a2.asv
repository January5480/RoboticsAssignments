clc; clear; close all;

I = imread('../实验课数据/校徽拼接/Picture.png');
x = SplitArray(I, 18);




function [x] = SplitArray(Array, n)
    % 获取数组的行数和列数
    row = size(Array, 1);
    column = size(Array, 2);

    % 初始化一个 cell 来存储分割后的数组
    x = cell(1, n);

    % 计算每一份的列数
    col_per_part = fix(column / n);

    % 遍历每一部分
    for j = 1:n
        % 确定每一部分的列范围
        if j == n
            % 最后一部分可能包含剩余列的
            x{j} = Array(:, (j - 1) * col_per_part + 1:end);
        else
            x{j} = Array(:, (j - 1) * col_per_part + 1:j * col_per_part);
        end
    end
end

