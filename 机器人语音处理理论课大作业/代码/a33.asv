
fprintf('开始识别\n');
k = 1; %第几个人
j = 5; %数字
rec_sph=speechSegments(k,j).segment; % 随机选择一条待识别语音
fprintf('该语音的真实值为%d\n',j);
rec_fea = mfcc(rec_sph);  % 特征提取

% 求出当前语音关于各数字hmm的p(X|M)
for i=1:10
  pxsm(i) = viterbi(hmm{i}, rec_fea); 
end
[d,n] = max(pxsm); % 判决，将该最大值对应的序号作为识别结果
fprintf('该语音识别结果为%d\n',n)

count = 
for k = 1 : 3
    for j = 1 : 10
        rec_sph=speechSegments(k,j).segment; % 随机选择一条待识别语音
        fprintf('该语音的真实值为%d\n',j);
        rec_fea = mfcc(rec_sph);  % 特征提取
        for i=1:10
          pxsm(i) = viterbi(hmm{i}, rec_fea); 
        end
        [d,n] = max(pxsm); % 判决，将该最大值对应的序号作为识别结果
        if n == j
            count = count + 1;
        end
    end
end




















